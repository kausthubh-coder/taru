// Worker config. Wrangler reads this for dev, deploy and tests (@cloudflare/vitest-plugin only reads Wrangler config,
// which is why this project uses Wrangler and not the beta `cf` CLI).
// After changing bindings, run `bun run cf-typegen` to regenerate worker-configuration.d.ts.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "taru",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-19",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		// The Worker reads two HTML shells through this binding: the web app's (for every /app path) and the docs'.
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		// Git clients, the JSON API and MCP must reach the Worker, never the SPA fallback. So must the docs, which
		// the Worker renders, and the app's deep links, which all get the app shell.
		"run_worker_first": ["/api/*", "/mcp", "/*/*.git", "/*/*.git/*", "/docs", "/docs/*", "/docs.md", "/llms.txt", "/llms-full.txt", "/skills/*", "/app", "/app/*"]
	},
	"observability": {
		"enabled": true,
		"traces": { "enabled": true }
	},
	"upload_source_maps": true,
	"durable_objects": {
		// One RepoObject per repository: refs, commit graph and small objects live in its SQLite.
		"bindings": [{ "name": "REPO", "class_name": "RepoObject" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["RepoObject"] }],
	"r2_buckets": [
		// Large file contents, keyed by content hash.
		{ "binding": "BLOBS", "bucket_name": "taru-blobs" }
	],
	"d1_databases": [
		// Accounts, repo index, waitlist. Migrations in migrations/.
		{ "binding": "DB", "database_name": "taru", "migrations_dir": "migrations" }
	]
	// Secrets (set with `wrangler secret put`, locally in .dev.vars):
	//   TARU_ADMIN_TOKEN     password for git push and repo creation until accounts land
	//   GITHUB_MIRROR_TOKEN  optional: fine-grained PAT the GitHub copy pushes with (contents: read and write on the
	//                        target repos). Unset locally, where the copy goes to scripts/fake-github.mjs
}
